{
    "name": "hesamrad/laravel-sql-logger",
    "description": "A lightweight package to log SQL queries in your Laravel application",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/hesamzakerirad/laravel-sql-logger",
    "require": {
        "php": "^8.1",
        "psr/log": "^3.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/config": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "HesamRad\\LaravelSqlLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HesamRad\\LaravelSqlLogger\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Hesam Rad",
            "email": "hesamzakerirad@gmail.com",
            "homepage": "https://hesamrad.com",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "extra": {
        "laravel": {
            "providers": [
                "HesamRad\\LaravelSqlLogger\\LaravelSqlLoggerServiceProvider"
            ]
        }
    }
}
